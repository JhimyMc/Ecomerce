@model List<ECommerce.Models.CartItem>

@{
    ViewData["Title"] = "Mi Carrito";
}

<div class="container">
    <h2 class="mb-4 text-center"><i class="ti ti-shopping-cart"></i> Mi Carrito</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="ti ti-shopping-cart-x"></i> Tu carrito esta vacio.
            <br />
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-sm mt-2">
                <i class="ti ti-shopping-bag"></i> Ir a comprar
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Zapatilla</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                        <th>Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Name</td>
                            <td>@item.UnitPrice.ToString("C", new System.Globalization.CultureInfo("es-PE"))</td>
                            <td>
                                <form asp-controller="Cart" asp-action="Update" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="number" name="qty" value="@item.Quantity" min="1"
                                        class="form-control form-control-sm d-inline-block" style="width:70px;" />
                                    <button type="submit" class="btn btn-sm btn-primary ms-1">Actualizar</button>
                                </form>
                            </td>
                            <td class="fw-bold" style="color:#CC0000;">
                                @((item.UnitPrice * item.Quantity).ToString("C", new System.Globalization.CultureInfo("es-PE")))
                            </td>
                            <td>
                                <form asp-controller="Cart" asp-action="Update" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="qty" value="0" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="ti ti-trash"></i> Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <h4>
                Total:
                <span class="fw-bold" style="color:#CC0000;">
                    @Model.Sum(x => x.UnitPrice * x.Quantity).ToString("C", new System.Globalization.CultureInfo("es-PE"))
                </span>
            </h4>

            <div class="d-flex gap-2">
                <form asp-controller="Products" asp-action="Index" method="get">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left"></i> Seguir comprando
                    </button>
                </form>
                <form asp-controller="Checkout" asp-action="Confirm" method="get">
                    <button type="submit" class="btn btn-sm fw-bold" style="background-color:#CC0000; color:#fff;">
                        <i class="ti ti-check"></i> Confirmar Compra
                    </button>
                </form>
            </div>
        </div>
    }
</div>
