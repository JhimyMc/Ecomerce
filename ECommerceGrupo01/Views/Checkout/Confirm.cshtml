@model List<ECommerce.Models.CartItem>

@{
    ViewData["Title"] = "Confirmar Compra";
}

<div class="container mt-4">
    <h2><i class="ti ti-check-circle"></i> Confirmar Compra</h2>

    <form asp-action="Confirm" method="post">
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Zapatilla</th>
                    <th>Precio Unitario</th>
                    <th>Cantidad</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.UnitPrice.ToString("C", new System.Globalization.CultureInfo("es-PE")))</td>
                    <td>@item.Quantity</td>
                    <td>@((item.UnitPrice * item.Quantity).ToString("C", new System.Globalization.CultureInfo("es-PE")))</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="table-secondary fw-bold">
                    <td colspan="3" class="text-end">Total General:</td>
                    <td>
                        @Model.Sum(x => x.UnitPrice * x.Quantity).ToString("C", new System.Globalization.CultureInfo("es-PE"))
                    </td>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex justify-content-between mt-3">
            <a asp-controller="Cart" asp-action="Index" class="btn btn-secondary">
                <i class="ti ti-arrow-left"></i> Volver al Carrito
            </a>
            <button type="submit" class="btn btn-success">
                <i class="ti ti-check"></i> Confirmar Compra
            </button>
        </div>
    </form>
</div>
