@model List<ECommerce.Models.Order>

@{
    ViewData["Title"] = "Historial de Compras";
}

<div class="container">
    <h1 class="mb-4 text-center"><i class="ti ti-receipt"></i> Historial de Compras</h1>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="ti ti-shopping-cart-x"></i> No tienes compras registradas.
            <br />
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-sm mt-2">
                <i class="ti ti-shopping-bag"></i> Ir a comprar
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th># Pedido</th>
                        <th>Fecha</th>
                        <th>Zapatillas</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.OrderByDescending(o => o.CreatedAt))
                    {
                        <tr>
                            <td class="fw-bold">@order.Id</td>
                            <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <ul class="mb-0">
                                    @foreach (var item in order.Items)
                                    {
                                        <li>
                                            <span class="fw-bold">@(item.Product?.Name ?? item.ProductName)</span>
                                            (<span class="text-primary">@item.Quantity UND</span>) -
                                            <span class="joefar-price">@item.UnitPrice.ToString("C", new System.Globalization.CultureInfo("es-PE"))</span>
                                        </li>
                                    }
                                </ul>
                            </td>
                            <td>
                                <span class="fw-bold joefar-price">
                                    @order.Total.ToString("C", new System.Globalization.CultureInfo("es-PE"))
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
